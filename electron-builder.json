{
  "appId": "com.grupotomaz.frota",
  "productName": "Checklist Frota",
  "copyright": "© 2025 Grupo Tomaz",
  "directories": {
    "output": "dist-electron",
    "buildResources": "public"
  },
  "asar": true,
  "asarUnpack": [
    ".output/server/**/*",
    ".output/public/**/*",
    "node_modules/**/*"
  ],
  "files": [
    "electron/main.cjs",
    "electron/configure-oracle-preload.cjs",
    "electron/configure-oracle.html",
    "electron/public-env.generated.json",
    ".output/**/*",
    "public/icons/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/electron/**/*",
    "!node_modules/electron-builder/**/*",
    "!node_modules/vite/**/*",
    "!node_modules/esbuild/**/*",
    "!node_modules/@esbuild/**/*",
    "!node_modules/.cache/**/*",
    "!node_modules/**/*.map",
    "!node_modules/**/test/**/*",
    "!node_modules/**/__tests__/**/*"
  ],
  "icon": "public/icons/icon.ico",
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "public/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Checklist Frota"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icons/icon-512.png",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icons/icon-512.png",
    "category": "Utility"
  }
}